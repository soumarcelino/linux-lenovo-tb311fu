#!/bin/sh
set -eu
export XDG_SESSION_TYPE=wayland XDG_SESSION_DESKTOP=KDE XDG_CURRENT_DESKTOP=KDE
export XDG_SEAT=seat0 QT_QPA_PLATFORM=wayland
export KWIN_DRM_DEVICES=/dev/dri/by-path/platform-14000000.dispsys_config-card
export KWIN_DRM_DISABLE_TRIPLE_BUFFERING=1
export KWIN_DRM_PREFER_COLOR_DEPTH=24 KWIN_COMPOSE=O2 KWIN_FORCE_SW_CURSOR=1
unset KWIN_DRM_USE_MODIFIERS KWIN_DRM_NO_DIRECT_SCANOUT KWIN_DRM_FORCE_GL_FINISH_PRESENT
export MOZ_ENABLE_WAYLAND=1 GDK_BACKEND=wayland GSK_RENDERER=gl
unset QSG_RENDER_TIMING QSG_NO_VSYNC QSG_RENDER_LOOP
export XDG_CACHE_HOME="$HOME/.cache/arch-plasma"
unset QML_DISABLE_DISK_CACHE QML_DISK_CACHE
unset LD_PRELOAD DISPLAY WAYLAND_DISPLAY DBUS_SESSION_BUS_ADDRESS
exec dbus-run-session -- /usr/bin/startplasmamobile

# Bring-up profile: preserve GKI vendor ABI; no desktop capability claim.
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_LOCALVERSION="-pmos-minimal"
CONFIG_LOCALVERSION_AUTO=n

# Waydroid: retain vendor ABI; Android does not use SysV IPC.
CONFIG_SYSVIPC=n
CONFIG_POSIX_MQUEUE=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=n
CONFIG_PID_NS=y
CONFIG_CGROUP_PIDS=n
CONFIG_CGROUP_DEVICE=n

# Arch Linux ARM/systemd userspace on the same validated vendor ABI.
CONFIG_FHANDLE=y
CONFIG_AUTOFS_FS=y
